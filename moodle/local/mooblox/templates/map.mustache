{{!
    @template local_mooblox/map

    Shell of the course map: the client mounts into the root; without scripts the course links show.

    Context variables required for this template:
    * title - page heading
    * courses - list of fullname and url
    * empty - text shown when there are no courses
    * configjson - JSON config for the client, HTML-safe encoded
    * bundleurl - URL of the client module bundle

    Example context (json):
    {
        "title": "Your worlds",
        "courses": [{"fullname": "Volcanoes", "url": "https://example.com/local/mooblox/play.php?id=2"}],
        "empty": "No worlds yet",
        "configjson": "{\"mode\":\"map\",\"wwwroot\":\"https://example.com\",\"courseid\":0,\"sesskey\":\"abc\",\"firstname\":\"Mia\",\"avatar\":\"\",\"rev\":1}",
        "bundleurl": "https://example.com/local/mooblox/client/dist/mooblox.js?rev=1"
    }
}}
<h1 class="sr-only">{{title}}</h1>
<div id="mooblox-root" class="local-mooblox-root"></div>
<noscript>
    <ul class="local-mooblox-maplist">
        {{#courses}}
        <li><a href="{{url}}">{{fullname}}</a></li>
        {{/courses}}
        {{^courses}}
        <li>{{empty}}</li>
        {{/courses}}
    </ul>
</noscript>
<script type="application/json" id="mooblox-config">{{{configjson}}}</script>
<script type="module" src="{{bundleurl}}"></script>
